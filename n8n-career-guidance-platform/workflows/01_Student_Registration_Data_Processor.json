    {
      "parameters": {
        "jsCode": "// Data Validation & Normalization Code\nconst input = $input.first().json.body || $input.first().json;\n\nconst fullName = input.fullName || input['Full Name'] || 'Anonymous Student';\nconst email = input.email || input['Email Address'] || '';\nconst degree = input.degree || input['Current Academic Degree'] || 'Engineering';\nconst targetGoal = input.targetGoal || input['Target Career Goal'] || 'Full-Stack Developer';\nconst currentSkills = input.currentSkills || input['Current Technical Skills'] || 'Basic Programming';\nconst studentId = input.studentId || ('STU-' + Math.floor(100000 + Math.random() * 900000));\n\nif (!email || !email.includes('@')) {\n  throw new Error('Invalid email provided in form payload.');\n}\n\nreturn [{\n  json: {\n    studentId,\n    fullName,\n    email,\n    degree,\n    graduationYear: input.graduationYear || '2026',\n    targetGoal,\n    currentSkills,\n    weeklyTime: input.weeklyTime || '10-20 Hours/week',\n    preferredLanguage: input.preferredLanguage || 'English',\n    status: 'REGISTERED',\n    registeredAt: new Date().toISOString()\n  }\n}];"
      },
