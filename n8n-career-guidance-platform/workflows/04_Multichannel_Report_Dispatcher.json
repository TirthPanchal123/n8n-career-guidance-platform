    {
      "parameters": {
        "jsCode": "const student = $input.first().json.body || $input.first().json;\nconst ai = student.aiAnalysis || {};\nconst courses = student.matchedCourses || [];\nconst internships = student.matchedInternships || [];\n\nconst courseList = courses.map(c => `<li><a href=\"${c.url}\" target=\"_blank\"><strong>${c.title}</strong></a> (${c.platform})</li>`).join('');\nconst internshipList = internships.map(i => `<li><strong>${i.title}</strong> at ${i.company} (${i.location})</li>`).join('');\nconst skillGapList = (ai.skillGap || ['Advanced Software Design', 'Cloud APIs']).map(s => `<li><strong>${s}</strong></li>`).join('');\n\nconst htmlEmail = `<!DOCTYPE html><html><head><style>body{font-family:Arial,sans-serif;background:#f4f6f9;color:#333;margin:0;padding:20px}.card{max-width:650px;margin:0 auto;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 15px rgba(0,0,0,.08)}.header{background:linear-gradient(135deg,#4f46e5,#7c3aed);color:#fff;padding:30px 25px;text-align:center}.content{padding:25px;line-height:1.6}.box{background:#f8fafc;border-left:4px solid #6366f1;padding:15px;margin:15px 0;border-radius:4px}.footer{background:#f1f5f9;text-align:center;padding:15px;font-size:12px;color:#64748b}</style></head><body><div class=\"card\"><div class=\"header\"><h1 style=\"margin:0\">Your AI Career Roadmap Report</h1><p style=\"margin:5px 0 0;opacity:.9\">Prepared for ${student.fullName}</p></div><div class=\"content\"><p>Dear <strong>${student.fullName}</strong>,</p><p>Our AI Career Engine has analyzed your profile and target goal of <strong>${student.targetGoal}</strong>.</p><div class=\"box\"><h3 style=\"margin-top:0;color:#4f46e5\">Skill Gap Analysis</h3><ul>${skillGapList}</ul></div><h3>4-Week Learning Roadmap</h3><ul><li><strong>Week 1:</strong> ${ai.week1Roadmap || 'Master core foundational concepts.'}</li><li><strong>Week 2:</strong> ${ai.week2Roadmap || 'Build RESTful APIs and data flows.'}</li><li><strong>Week 3:</strong> ${ai.week3Roadmap || 'Implement database and ORM integrations.'}</li><li><strong>Week 4:</strong> ${ai.week4Roadmap || 'Deploy live project to cloud.'}</li></ul><div class=\"box\" style=\"border-color:#10b981;background:#ecfdf5\"><h3 style=\"margin-top:0;color:#059669\">Recommended Capstone Project</h3><p><strong>${ai.topProjectIdea || 'AI Automation Dashboard'}</strong></p></div><h3>Recommended Learning Resources</h3><ul>${courseList}</ul><h3>Matched Internship Roles</h3><ul>${internshipList}</ul></div><div class=\"footer\">AI-Powered Student Career Guidance Platform - n8n Capstone</div></div></body></html>`;\n\nreturn [{\n  json: {\n    ...student,\n    htmlEmail,\n    emailSubject: `Your Personalized AI Career Roadmap - ${student.targetGoal}`\n  }\n}];"
      },
